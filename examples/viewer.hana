// 3D viewer with a rotating model and an in-scene panel.
app Viewer {
    state rot: float = 0
    state spinning: bool = true
    state selected_name: string = ""

    action tick(dt: float) {
        if spinning {
            rot = rot + 30 * dt
        }
    }

    action select_part() {
        selected_name = "part"
    }

    scene model_scene {
        on_frame: tick

        camera {
            id: main_cam
            transform { position: (0, 2, 5) }
            target: (0, 0, 0)
            fov: 60
        }

        light { type: directional; direction: (-1, -1, -1); intensity: 3.0 }

        mesh {
            source: "part.gltf"
            transform { rotation: (0, rot, 0) }
            material { metallic: 0.8; roughness: 0.3 }
            on_click: select_part
        }

        if selected_name != "" {
            panel3d {
                transform { position: (1.5, 1, 0) }
                size: 1x0.6

                label { text: "Selected: {selected_name}" }
                button { text: "Close"; on_click: { selected_name = "" } }
            }
        }
    }

    window {
        title: "Viewer"
        size: 1280x720

        row {
            viewport3d { scene: model_scene; camera: main_cam }

            column {
                width: 300

                slider { label: "Rotation"; value: bind rot; min: 0; max: 360 }
                checkbox { text: "Spin"; checked: bind spinning }
            }
        }
    }
}
