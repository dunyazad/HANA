// Minimal counter app.
app Counter {
    state count: int = 0

    action increment() {
        count = count + 1
    }

    action reset() {
        count = 0
    }

    window title: "Counter" size: 300x200 {
        column spacing: 8 {
            label text: "Count: {count}"
            row {
                button text: "+1" on_click: increment
                button text: "Reset" on_click: reset enabled: count > 0
            }
        }
    }
}
