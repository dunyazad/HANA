// for loops over integer ranges: exclusive and inclusive ends, empty
// ranges, the full range of a type, break/continue, nesting, and a loop
// variable whose type is inferred from its use.
{
  sum: fn<i64(n: i64)> '''
    var total = 0
    for i in 0..n:
      total += i
    return total
  ''',
  main: fn '''
    print(sum(10))
    for i in 0..3:
      write(f"{i} ")
    print("")
    for i in 1..=3:
      write(f"{i} ")
    print("")
    var count = 0
    for b in 0u8..=255:
      count += 1
    print(count)
    for i in 5..5:
      print("never")
    for i in 5..=4:
      print("never")
    for i in -3..3:
      if i == 0: continue
      if i == 2: break
      write(f"{i} ")
    print("")
    var big: i64 = 0
    for i in 0..10:
      big += i * 1000000000000
    print(big)
    for i in 9223372036854775806i64..=9223372036854775807:
      print(i)
    var nested = 0
    for i in 0..4:
      for j in i..4:
        nested += 1
    print(nested)
  ''',
}
