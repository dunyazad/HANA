fn main() {
    let a = 7
    let b = 3
    println("{a + b} {a - b} {a * b} {a / b} {a % b}")
    println("{-a / b} {-a % b}")
    let x: u8 = 250
    println("{x + 10}")
    let big: i64 = 9_000_000_000
    println("{big * 2}")
    println("{0xff} {0b1010} {1_000}")
    println("{1 << 4} {256 >> 4} {6 & 3} {6 | 3} {6 ^ 3} {~0}")
    let shift: u32 = 1
    println("{shift << 33}")
    let f = 1.5
    println("{f * 2.0} {10.0 / 4.0}")
    let small: f32 = 0.25
    println("{small}")
}
