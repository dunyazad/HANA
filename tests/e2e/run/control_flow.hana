fn classify(n: i32) -> str {
    if n < 0 {
        return "negative"
    } else if n == 0 {
        return "zero"
    }
    return "positive"
}

fn main() {
    var i = 0
    var sum = 0
    while i < 10 {
        i += 1
        if i % 2 == 0 {
            continue
        }
        sum += i
    }
    println("sum of odd numbers up to 10: {sum}")

    var n = 0
    loop {
        n += 1
        if n >= 5 {
            break
        }
    }
    println("loop stopped at {n}")

    println(classify(-3))
    println(classify(0))
    println(classify(8))
}
