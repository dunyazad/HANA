fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn swap(inout a: i32, inout b: i32) {
    let t = a
    a = b
    b = t
}

fn add_twice(inout total: i32, amount: i32) {
    total += amount
    total += amount
}

fn main() {
    println("fib(20) = {fib(20)}")
    var x = 1
    var y = 2
    swap(&x, &y)
    println("x = {x}, y = {y}")
    var total = 10
    add_twice(&total, 5)
    println("total = {total}")
}
