    let c: i32? = 5
    print(c)
    let d = c + 1
    print(c == 5)
    print(c < null)
    var n = 3
    takes(&n)
    let e = Some(1, 2)
    let f: u8? = 300
    match c:
      Some(v): pass
    match c:
      Some: pass
      null: pass
    match c:
      Some(1): pass
      null: pass
    match c:
      Some(_): pass
      null: pass
      Some(2): pass
    match 5:
      null: pass
      _: pass
    let p = P { s: "a" }
    let o: P? = p
