{
  P: struct { s: str },
  eat: fn<(sink p: P)> pass,
  main: fn '''
    for x in 0.0..1.0:
      pass
    let a: i64 = 3
    let b: i32 = 4
    for x in a..b:
      pass
    for x in 0..3:
      x = 2
    for c in 'a'..'z':
      pass
    let p = P { s: "a" }
    for i in 0..3:
      eat(p)
    print(x)
  ''',
}
