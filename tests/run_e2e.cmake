# Runs one end-to-end test. Inputs: HANA (tool path), SOURCE (.hana file),
# MODE ("run" or "error"). Optional <name>.flags holds extra 'hana run' options.
get_filename_component(dir ${SOURCE} DIRECTORY)
get_filename_component(name ${SOURCE} NAME_WE)

if(MODE STREQUAL "run")
    set(flags "")
    if(EXISTS ${dir}/${name}.flags)
        file(READ ${dir}/${name}.flags flags)
        string(STRIP "${flags}" flags)
        separate_arguments(flags)
    endif()
    execute_process(COMMAND ${HANA} run ${flags} ${SOURCE}
        OUTPUT_VARIABLE actual ERROR_VARIABLE errors RESULT_VARIABLE status)
    set(expected_status 0)
    if(EXISTS ${dir}/${name}.status)
        file(READ ${dir}/${name}.status expected_status)
        string(STRIP "${expected_status}" expected_status)
    endif()
    if(NOT status STREQUAL expected_status)
        message(FATAL_ERROR "exit status ${status}, expected ${expected_status}\n${errors}")
    endif()
    file(READ ${dir}/${name}.out expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "output differs\n--- expected\n${expected}--- actual\n${actual}")
    endif()
    if(EXISTS ${dir}/${name}.stderr)
        file(STRINGS ${dir}/${name}.stderr needles)
        foreach(needle IN LISTS needles)
            string(FIND "${errors}" "${needle}" found)
            if(found EQUAL -1)
                message(FATAL_ERROR "stderr lacks '${needle}'\n${errors}")
            endif()
        endforeach()
    endif()
elseif(MODE STREQUAL "error")
    execute_process(COMMAND ${HANA} check ${SOURCE}
        OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE status)
    if(status EQUAL 0)
        message(FATAL_ERROR "expected compile errors, but check succeeded")
    endif()
    file(STRINGS ${dir}/${name}.err needles)
    foreach(needle IN LISTS needles)
        string(FIND "${errors}" "${needle}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "diagnostics lack '${needle}'\n${errors}")
        endif()
    endforeach()
else()
    message(FATAL_ERROR "unknown MODE '${MODE}'")
endif()
